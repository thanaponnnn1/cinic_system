{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./frontend/src/app/globals.css",
  "overrides": [
    {
      "files": "*.md",
      "options": { "printWidth": 120 }
    }
  ]
}
