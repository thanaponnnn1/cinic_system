{
  "name": "@clinicq/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, enums และ brand tokens ที่ backend กับ frontend ใช้ร่วมกัน",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
