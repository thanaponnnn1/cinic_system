# THNP ClinicQ — ตัวแปรสภาพแวดล้อมของ dashboard
# คัดลอกเป็น .env.local แล้วแก้ค่าตามเครื่องของคุณ
#
#   cp frontend/.env.example frontend/.env.local

# ที่อยู่ของ API — ต้องตรงกับ PORT ที่ตั้งไว้ใน backend/.env
# อ่านตอนรัน ไม่ได้ฝังลงบันเดิล ย้ายเซิร์ฟเวอร์แล้วไม่ต้อง build ใหม่
CLINICQ_API_URL=http://localhost:3001

# หน้าลูกค้า (LIFF) — LIFF ID จาก LINE Developers Console ฝังตอน build
# ไม่ตั้ง = หน้า /c ใช้ได้เฉพาะโหมดเดโม (backend DEMO_MODE=true)
NEXT_PUBLIC_LIFF_ID=
# ลิงก์แชท LINE OA ของร้าน เช่น https://line.me/R/ti/p/@xxxx — ไม่ตั้ง = ไม่แสดงปุ่ม "ทักแชทร้านใน LINE"
NEXT_PUBLIC_LINE_OA_URL=
