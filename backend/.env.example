# THNP ClinicQ — ตัวแปรสภาพแวดล้อมของ backend
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit .env เข้า git)
#
#   cp backend/.env.example backend/.env

# ── พื้นฐาน ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# ต้องเป็น Asia/Bangkok เสมอ ไม่งั้นงานเตือนนัดจะยิงผิดเวลา
TZ=Asia/Bangkok

# ── ฐานข้อมูล ────────────────────────────────────────────
# พอร์ต 5434 ตรงกับที่ docker-compose.yml map ไว้ (เลี่ยงชนกับ postgres ตัวอื่นในเครื่อง)
DATABASE_URL="postgresql://clinicq:clinicq_dev_pw@localhost:5434/clinicq?schema=public"

# ── Redis (บังคับตั้งแต่ Phase 4 — คิวงานเตือนนัดและนาฬิกาเดโม) ──
REDIS_URL="redis://localhost:6380"

# ── Frontend ────────────────────────────────────────────
# ใช้ตั้งค่า CORS และประกอบลิงก์ที่ส่งไปในข้อความ LINE
FRONTEND_URL=http://localhost:3000

# ── ความปลอดภัย (ใช้จริงตั้งแต่ Phase 1) ─────────────────
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# session ของลูกค้าที่เข้าหน้าร้านผ่าน LIFF (Phase 10) — ต้องไม่ซ้ำกับสองค่าข้างบน
JWT_CUSTOMER_SECRET=replace-me-with-a-third-long-random-string

# ── LINE Messaging API (ใช้จริงตั้งแต่ Phase 3) ──────────
# ห้ามใช้ LINE Notify — ปิดให้บริการไปแล้ว
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# userId ของแอดมินร้าน สำหรับรับแจ้งเตือนระบบและสรุปปิดร้าน
# (ได้จาก webhook event ตอนทักบอทครั้งแรก — ไม่ใช่ LINE ID ที่ขึ้นต้นด้วย @)
LINE_ADMIN_USER_ID=
# Channel ID ของ LINE Login channel ที่สร้าง LIFF app ไว้ (Phase 10) — ใช้ตรวจ ID token ของลูกค้า
# ไม่ตั้ง = หน้าลูกค้าเข้าผ่าน LINE ไม่ได้ แต่ทางเข้าโหมดเดโมยังใช้ได้ตามปกติ
LINE_LIFF_CHANNEL_ID=
# LIFF ID ของหน้าลูกค้า รูปแบบ 1234567890-AbCdEfGh (ไม่ใช่ URL เต็ม) — endpoint URL ของ LIFF app ต้องเป็นรากของเว็บ
# ตั้งแล้วข้อความแคมเปญดึงลูกค้ากลับ เตือนคอร์สใกล้หมดอายุ และคำตอบอัตโนมัติในแชทจะมีลิงก์จองคิว
# ไม่ตั้ง = ข้อความทุกฉบับเหมือนเดิม ไม่มีลิงก์
LIFF_ID=

# ── หน้าจอดูคิวงาน /admin/queues (Phase 4) ───────────────
# ไม่ตั้งค่า = ไม่เปิดหน้านี้เลย · ตั้งแล้วต้องใส่รหัสผ่านก่อนเข้า
# หน้านี้สั่งลบและสั่งรันงานในคิวได้ ห้ามเปิดสาธารณะ
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ── รหัสผ่านบัญชีเดโมของ seed ────────────────────────────
# รหัสของ owner/staff/demo@thnpclinic.com ที่ pnpm db:seed สร้าง · ไม่ตั้ง = demo1234
# ตั้งค่าเองก่อนเปิดหน้าจอร้านให้เข้าจากอินเทอร์เน็ต (seed เตือนถ้าใช้ demo1234 คู่กับ NODE_ENV=production)
# seed ไม่ทับรหัสของบัญชีที่มีอยู่แล้ว เปลี่ยนค่านี้แล้ว seed ซ้ำ รหัสเดิมยังใช้ได้อยู่
# เปลี่ยนรหัสของบัญชีที่มีอยู่: NEW_PASSWORD=รหัสใหม่ pnpm user:set-password owner@thnpclinic.com
#   (ไม่ตั้ง NEW_PASSWORD = สุ่มรหัสให้และพิมพ์ออกจอครั้งเดียว · ทุกเครื่องที่ล็อกอินค้างไว้ถูกออกจากระบบ)
SEED_PASSWORD=

# ── โหมดเดโม ────────────────────────────────────────────
# true = เปิด /api/demo/* (ปุ่มข้ามเวลา, รีเซ็ตข้อมูล) และทางเข้าหน้าลูกค้าแบบไม่ต้องใช้ LINE
# แอปไม่ยอม boot ถ้าตั้ง true คู่กับ NODE_ENV=production
DEMO_MODE=true
