# THNP ClinicQ — ตัวแปรสภาพแวดล้อมของ backend
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit .env เข้า git)
#
#   cp backend/.env.example backend/.env

# ── พื้นฐาน ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# ต้องเป็น Asia/Bangkok เสมอ ไม่งั้นงานเตือนนัดจะยิงผิดเวลา
TZ=Asia/Bangkok

# ── ฐานข้อมูล ────────────────────────────────────────────
# พอร์ต 5433 ตรงกับที่ docker-compose.yml map ไว้ (เลี่ยงชนกับ postgres ตัวอื่นในเครื่อง)
DATABASE_URL="postgresql://clinicq:clinicq_dev_pw@localhost:5433/clinicq?schema=public"

# ── Redis (ใช้จริงตั้งแต่ Phase 4 — คิวงานเตือนนัด) ──────
REDIS_URL="redis://localhost:6380"

# ── Frontend ────────────────────────────────────────────
# ใช้ตั้งค่า CORS และประกอบลิงก์ที่ส่งไปในข้อความ LINE
FRONTEND_URL=http://localhost:3000

# ── ความปลอดภัย (ใช้จริงตั้งแต่ Phase 1) ─────────────────
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── LINE Messaging API (ใช้จริงตั้งแต่ Phase 3) ──────────
# ห้ามใช้ LINE Notify — ปิดให้บริการไปแล้ว
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# userId ของแอดมินร้าน สำหรับรับแจ้งเตือนระบบและสรุปปิดร้าน
# (ได้จาก webhook event ตอนทักบอทครั้งแรก — ไม่ใช่ LINE ID ที่ขึ้นต้นด้วย @)
LINE_ADMIN_USER_ID=

# ── โหมดเดโม ────────────────────────────────────────────
# true = เปิด /api/demo/* (ปุ่มข้ามเวลา, รีเซ็ตข้อมูล) — ต้องเป็น false เสมอบน production ของลูกค้าจริง
DEMO_MODE=true
